# Docker uses its own Python runtime; it cannot reuse the host interpreter directly.
# Keep this aligned with the latest stable Python version approved for the project.
PYTHON_VERSION=3.14.5

# Optional container UID/GID overrides for Linux bind mounts.
# APP_UID=1000
# APP_GID=1000

# Release installers set these non-secret deployment controls.
# TMB_IMAGE=ghcr.io/hamedsanaei/telegram-media-downloader-bot:latest
# COMPOSE_PROFILES=local-api
