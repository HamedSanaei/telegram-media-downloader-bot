{
  "$defs": {
    "AppSection": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "default": "production",
          "enum": [
            "development",
            "test",
            "production"
          ],
          "title": "Environment",
          "type": "string"
        },
        "log_level": {
          "default": "INFO",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "title": "Log Level",
          "type": "string"
        },
        "log_format": {
          "default": "json",
          "enum": [
            "json",
            "console"
          ],
          "title": "Log Format",
          "type": "string"
        },
        "language": {
          "default": "fa",
          "title": "Language",
          "type": "string"
        },
        "timezone": {
          "default": "Asia/Tehran",
          "title": "Timezone",
          "type": "string"
        }
      },
      "title": "AppSection",
      "type": "object"
    },
    "CookieHealthSection": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "expiring_soon_hours": {
          "default": 24,
          "maximum": 720,
          "minimum": 1,
          "title": "Expiring Soon Hours",
          "type": "number"
        },
        "reminder_interval_minutes": {
          "default": 180,
          "maximum": 10080,
          "minimum": 15,
          "title": "Reminder Interval Minutes",
          "type": "integer"
        },
        "recovery_notifications": {
          "default": true,
          "title": "Recovery Notifications",
          "type": "boolean"
        }
      },
      "title": "CookieHealthSection",
      "type": "object"
    },
    "DownloadMode": {
      "enum": [
        "best",
        "best_original",
        "video_2160",
        "video_1440",
        "video_1080",
        "video_720",
        "video_480",
        "audio_best",
        "audio_mp3",
        "image_original",
        "images_original",
        "all_original_media",
        "images_only",
        "videos_only",
        "video_original",
        "images_zip",
        "youtube_thumbnail",
        "soundcloud_artwork",
        "instagram_all_stories",
        "instagram_highlight"
      ],
      "title": "DownloadMode",
      "type": "string"
    },
    "FormatSection": {
      "additionalProperties": false,
      "properties": {
        "best": {
          "title": "Best",
          "type": "string"
        },
        "best_original": {
          "default": "bv*+ba/b",
          "title": "Best Original",
          "type": "string"
        },
        "video_2160": {
          "default": "bv*[height<=2160]+ba/b[height<=2160]",
          "title": "Video 2160",
          "type": "string"
        },
        "video_1440": {
          "default": "bv*[height<=1440]+ba/b[height<=1440]",
          "title": "Video 1440",
          "type": "string"
        },
        "video_1080": {
          "title": "Video 1080",
          "type": "string"
        },
        "video_720": {
          "title": "Video 720",
          "type": "string"
        },
        "video_480": {
          "title": "Video 480",
          "type": "string"
        },
        "audio_best": {
          "title": "Audio Best",
          "type": "string"
        },
        "audio_mp3": {
          "title": "Audio Mp3",
          "type": "string"
        }
      },
      "required": [
        "best",
        "video_1080",
        "video_720",
        "video_480",
        "audio_best",
        "audio_mp3"
      ],
      "title": "FormatSection",
      "type": "object"
    },
    "GalleryDlCookiesSection": {
      "additionalProperties": false,
      "properties": {
        "instagram": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instagram"
        },
        "tiktok": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tiktok"
        },
        "twitter": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Twitter"
        },
        "pinterest": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pinterest"
        }
      },
      "title": "GalleryDlCookiesSection",
      "type": "object"
    },
    "GalleryDlSection": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "timeout_seconds": {
          "default": 600,
          "maximum": 86400,
          "minimum": 10,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_assets_per_job": {
          "default": 30,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Assets Per Job",
          "type": "integer"
        },
        "max_total_size_mb": {
          "default": 1024,
          "maximum": 8192,
          "minimum": 1,
          "title": "Max Total Size Mb",
          "type": "integer"
        },
        "max_concurrent_processes": {
          "default": 2,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Concurrent Processes",
          "type": "integer"
        },
        "sleep_request_seconds": {
          "default": 1.0,
          "maximum": 60,
          "minimum": 0,
          "title": "Sleep Request Seconds",
          "type": "number"
        },
        "enabled_platforms": {
          "default": [
            "instagram",
            "pinterest",
            "tiktok",
            "twitter"
          ],
          "items": {
            "type": "string"
          },
          "title": "Enabled Platforms",
          "type": "array",
          "uniqueItems": true
        },
        "cookies": {
          "$ref": "#/$defs/GalleryDlCookiesSection"
        },
        "images": {
          "$ref": "#/$defs/ImageValidationSection"
        },
        "album_max_items": {
          "default": 10,
          "maximum": 10,
          "minimum": 2,
          "title": "Album Max Items",
          "type": "integer"
        },
        "zip_threshold": {
          "default": 11,
          "maximum": 100,
          "minimum": 2,
          "title": "Zip Threshold",
          "type": "integer"
        }
      },
      "title": "GalleryDlSection",
      "type": "object"
    },
    "ImageValidationSection": {
      "additionalProperties": false,
      "properties": {
        "max_width": {
          "default": 20000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Width",
          "type": "integer"
        },
        "max_height": {
          "default": 20000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Height",
          "type": "integer"
        },
        "max_pixels": {
          "default": 100000000,
          "maximum": 500000000,
          "minimum": 1000000,
          "title": "Max Pixels",
          "type": "integer"
        }
      },
      "title": "ImageValidationSection",
      "type": "object"
    },
    "InboundUpdatesSection": {
      "additionalProperties": false,
      "description": "Retention and cleanup of the durable Telegram inbound-update inbox.",
      "properties": {
        "effect_pending_stale_minutes": {
          "default": 10,
          "maximum": 1440,
          "minimum": 1,
          "title": "Effect Pending Stale Minutes",
          "type": "integer"
        },
        "completed_retention_days": {
          "default": 14,
          "maximum": 365,
          "minimum": 1,
          "title": "Completed Retention Days",
          "type": "integer"
        },
        "terminal_failure_retention_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "title": "Terminal Failure Retention Days",
          "type": "integer"
        },
        "cleanup_batch_size": {
          "default": 500,
          "maximum": 5000,
          "minimum": 1,
          "title": "Cleanup Batch Size",
          "type": "integer"
        },
        "stuck_after_minutes": {
          "default": 60,
          "maximum": 10080,
          "minimum": 1,
          "title": "Stuck After Minutes",
          "type": "integer"
        },
        "effect_retention_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "title": "Effect Retention Days",
          "type": "integer"
        }
      },
      "title": "InboundUpdatesSection",
      "type": "object"
    },
    "InstagramSection": {
      "additionalProperties": false,
      "properties": {
        "auto_download": {
          "default": true,
          "title": "Auto Download",
          "type": "boolean"
        },
        "force_mp4": {
          "default": true,
          "title": "Force Mp4",
          "type": "boolean"
        },
        "ignore_images": {
          "default": true,
          "title": "Ignore Images",
          "type": "boolean"
        },
        "max_videos": {
          "default": 50,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Videos",
          "type": "integer"
        },
        "max_total_size_mb": {
          "default": 4096,
          "maximum": 8192,
          "minimum": 1,
          "title": "Max Total Size Mb",
          "type": "integer"
        },
        "max_stories_per_batch": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Stories Per Batch",
          "type": "integer"
        },
        "max_highlight_items": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Highlight Items",
          "type": "integer"
        }
      },
      "title": "InstagramSection",
      "type": "object"
    },
    "LocalBotApiMigrationSection": {
      "additionalProperties": false,
      "properties": {
        "auto_logout_from_cloud": {
          "const": false,
          "default": false,
          "title": "Auto Logout From Cloud",
          "type": "boolean"
        },
        "state_file": {
          "format": "path",
          "title": "State File",
          "type": "string"
        }
      },
      "title": "LocalBotApiMigrationSection",
      "type": "object"
    },
    "LocalBotApiSection": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "mode": {
          "default": "external",
          "enum": [
            "managed",
            "external"
          ],
          "title": "Mode",
          "type": "string"
        },
        "executable": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable"
        },
        "api_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Id"
        },
        "api_hash": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Hash"
        },
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8081,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "local_mode": {
          "default": true,
          "title": "Local Mode",
          "type": "boolean"
        },
        "working_directory": {
          "format": "path",
          "title": "Working Directory",
          "type": "string"
        },
        "temp_directory": {
          "format": "path",
          "title": "Temp Directory",
          "type": "string"
        },
        "log_file": {
          "format": "path",
          "title": "Log File",
          "type": "string"
        },
        "verbosity": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Verbosity",
          "type": "integer"
        },
        "auto_start": {
          "default": true,
          "title": "Auto Start",
          "type": "boolean"
        },
        "lifecycle_owner": {
          "default": "application",
          "enum": [
            "application",
            "service"
          ],
          "title": "Lifecycle Owner",
          "type": "string"
        },
        "startup_timeout_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "title": "Startup Timeout Seconds",
          "type": "integer"
        },
        "shutdown_timeout_seconds": {
          "default": 20,
          "maximum": 300,
          "minimum": 1,
          "title": "Shutdown Timeout Seconds",
          "type": "integer"
        },
        "migration": {
          "$ref": "#/$defs/LocalBotApiMigrationSection"
        }
      },
      "title": "LocalBotApiSection",
      "type": "object"
    },
    "MediaSection": {
      "additionalProperties": false,
      "properties": {
        "enabled_sources": {
          "items": {
            "type": "string"
          },
          "title": "Enabled Sources",
          "type": "array",
          "uniqueItems": true
        },
        "enabled_modes": {
          "default": [
            "best",
            "best_original",
            "video_2160",
            "video_1440",
            "video_1080",
            "video_720",
            "video_480",
            "audio_best",
            "audio_mp3",
            "image_original",
            "images_original",
            "all_original_media",
            "images_only",
            "videos_only",
            "video_original",
            "images_zip",
            "youtube_thumbnail",
            "soundcloud_artwork",
            "instagram_all_stories",
            "instagram_highlight"
          ],
          "items": {
            "$ref": "#/$defs/DownloadMode"
          },
          "title": "Enabled Modes",
          "type": "array"
        },
        "default_mode": {
          "$ref": "#/$defs/DownloadMode",
          "default": "best"
        },
        "allow_playlists": {
          "default": false,
          "title": "Allow Playlists",
          "type": "boolean"
        },
        "playlist_max_items": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Playlist Max Items",
          "type": "integer"
        },
        "max_file_size_mb": {
          "default": 49,
          "minimum": 1,
          "title": "Max File Size Mb",
          "type": "integer"
        },
        "max_source_size_mb": {
          "default": 1024,
          "maximum": 8192,
          "minimum": 1,
          "title": "Max Source Size Mb",
          "type": "integer"
        },
        "max_duration_seconds": {
          "default": 14400,
          "minimum": 1,
          "title": "Max Duration Seconds",
          "type": "integer"
        },
        "mp4_native_fallback": {
          "$ref": "#/$defs/Mp4NativeFallback",
          "default": "lower_resolution"
        },
        "formats": {
          "$ref": "#/$defs/FormatSection"
        },
        "instagram": {
          "$ref": "#/$defs/InstagramSection"
        },
        "transcode": {
          "$ref": "#/$defs/TranscodeSection"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceCleanupSection"
        }
      },
      "required": [
        "enabled_sources",
        "formats"
      ],
      "title": "MediaSection",
      "type": "object"
    },
    "Mp4NativeFallback": {
      "enum": [
        "lower_resolution",
        "fail"
      ],
      "title": "Mp4NativeFallback",
      "type": "string"
    },
    "MultipartSection": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "seven_zip_executable": {
          "format": "path",
          "title": "Seven Zip Executable",
          "type": "string"
        },
        "part_size_mb": {
          "default": 1850,
          "maximum": 1900,
          "minimum": 1,
          "title": "Part Size Mb",
          "type": "integer"
        },
        "max_total_size_mb": {
          "default": 4096,
          "maximum": 8192,
          "minimum": 1,
          "title": "Max Total Size Mb",
          "type": "integer"
        },
        "compression_level": {
          "const": 0,
          "default": 0,
          "title": "Compression Level",
          "type": "integer"
        }
      },
      "title": "MultipartSection",
      "type": "object"
    },
    "ObservabilitySection": {
      "additionalProperties": false,
      "properties": {
        "health_host": {
          "default": "0.0.0.0",
          "title": "Health Host",
          "type": "string"
        },
        "health_port": {
          "default": 8080,
          "maximum": 65535,
          "minimum": 1,
          "title": "Health Port",
          "type": "integer"
        },
        "telegram_readiness_check": {
          "default": true,
          "title": "Telegram Readiness Check",
          "type": "boolean"
        },
        "metrics_enabled": {
          "default": true,
          "title": "Metrics Enabled",
          "type": "boolean"
        }
      },
      "title": "ObservabilitySection",
      "type": "object"
    },
    "OperationsSection": {
      "additionalProperties": false,
      "properties": {
        "update": {
          "$ref": "#/$defs/UpdateOperationsSection"
        },
        "inbound_updates": {
          "$ref": "#/$defs/InboundUpdatesSection"
        }
      },
      "title": "OperationsSection",
      "type": "object"
    },
    "PersistenceSection": {
      "additionalProperties": false,
      "properties": {
        "database_filename": {
          "default": "jobs.sqlite3",
          "title": "Database Filename",
          "type": "string"
        },
        "selection_ttl_seconds": {
          "default": 600,
          "maximum": 86400,
          "minimum": 60,
          "title": "Selection Ttl Seconds",
          "type": "integer"
        },
        "cleanup_interval_seconds": {
          "default": 60,
          "maximum": 86400,
          "minimum": 30,
          "title": "Cleanup Interval Seconds",
          "type": "integer"
        }
      },
      "title": "PersistenceSection",
      "type": "object"
    },
    "QueueSection": {
      "additionalProperties": false,
      "properties": {
        "max_jobs": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Jobs",
          "type": "integer"
        },
        "job_timeout_seconds": {
          "default": 1800,
          "minimum": 30,
          "title": "Job Timeout Seconds",
          "type": "integer"
        },
        "max_tries": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Tries",
          "type": "integer"
        },
        "keep_result_seconds": {
          "default": 3600,
          "minimum": 0,
          "title": "Keep Result Seconds",
          "type": "integer"
        },
        "retry_delay_seconds": {
          "default": 15,
          "maximum": 3600,
          "minimum": 1,
          "title": "Retry Delay Seconds",
          "type": "integer"
        }
      },
      "title": "QueueSection",
      "type": "object"
    },
    "RecoverySection": {
      "additionalProperties": false,
      "description": "Bounded automatic recovery of explicitly recoverable failed media jobs.",
      "properties": {
        "cookie_remediation_enabled": {
          "default": true,
          "title": "Cookie Remediation Enabled",
          "type": "boolean"
        },
        "app_fix_recovery_enabled": {
          "default": true,
          "title": "App Fix Recovery Enabled",
          "type": "boolean"
        },
        "max_recovery_attempts": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Recovery Attempts",
          "type": "integer"
        },
        "max_recoverable_age_days": {
          "default": 7,
          "maximum": 365,
          "minimum": 1,
          "title": "Max Recoverable Age Days",
          "type": "integer"
        },
        "notify_on_resume": {
          "default": true,
          "title": "Notify On Resume",
          "type": "boolean"
        },
        "remediation_batch_size": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Remediation Batch Size",
          "type": "integer"
        },
        "startup_recovery_batch_size": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Startup Recovery Batch Size",
          "type": "integer"
        },
        "reconciliation_batch_size": {
          "default": 50,
          "maximum": 1000,
          "minimum": 1,
          "title": "Reconciliation Batch Size",
          "type": "integer"
        },
        "queue_pressure_threshold": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Pressure Threshold"
        },
        "queue_backlog_per_worker_slot": {
          "default": 4,
          "maximum": 100,
          "minimum": 1,
          "title": "Queue Backlog Per Worker Slot",
          "type": "integer"
        },
        "max_recovery_per_user": {
          "default": 5,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Recovery Per User",
          "type": "integer"
        }
      },
      "title": "RecoverySection",
      "type": "object"
    },
    "RedisSection": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "default": "redis://redis:6379/0",
          "title": "Url",
          "type": "string"
        },
        "queue_name": {
          "default": "media-downloads",
          "title": "Queue Name",
          "type": "string"
        }
      },
      "title": "RedisSection",
      "type": "object"
    },
    "RequiredChannelSection": {
      "additionalProperties": false,
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "integer"
        },
        "title": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "join_url": {
          "title": "Join Url",
          "type": "string"
        }
      },
      "required": [
        "chat_id",
        "title",
        "join_url"
      ],
      "title": "RequiredChannelSection",
      "type": "object"
    },
    "RequiredChannelsSection": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "positive_cache_ttl_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 1,
          "title": "Positive Cache Ttl Seconds",
          "type": "integer"
        },
        "negative_cache_ttl_seconds": {
          "default": 30,
          "maximum": 3600,
          "minimum": 1,
          "title": "Negative Cache Ttl Seconds",
          "type": "integer"
        },
        "channels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RequiredChannelSection"
          },
          "title": "Channels",
          "type": "array"
        }
      },
      "title": "RequiredChannelsSection",
      "type": "object"
    },
