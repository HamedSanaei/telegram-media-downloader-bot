    "VaultKeyRingSection": {
      "additionalProperties": false,
      "description": "Ignored least-privilege key ring for the encrypted Instagram credential vault (T017).\n\nKeys are 32-byte AES-256 keys supplied as 64 hex characters and never leave configuration,\nlogs, SQLite, source, images, or metrics. ``active_key`` is used for new encryptions;\n``retained_keys`` are decrypt-only for rotation. All keys are optional so installs with user\ncredentials disabled start without any key material.",
      "properties": {
        "active_key_id": {
          "default": "",
          "title": "Active Key Id",
          "type": "string"
        },
        "active_key": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Key"
        },
        "retained_keys": {
          "additionalProperties": {
            "format": "password",
            "type": "string",
            "writeOnly": true
          },
          "title": "Retained Keys",
          "type": "object"
        }
      },
      "title": "VaultKeyRingSection",
      "type": "object"
    },
    "WebCompanionSection": {
      "additionalProperties": false,
      "description": "Separate least-privilege browser/callback boundary (T016), disabled by default.\n\nThe main (bot) settings surface additionally carries the bot-side handoff signing key, because\nthe bot mints secure connection links. The companion process uses a purpose-built reduced\nsettings model (``bootstrap.companion.CompanionSettings``) that never maps the signing key and\nnever maps ``telegram``, so its process objects contain no bot token and no signer.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8090,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "public_base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Base Url"
        },
        "session_max_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 60,
          "title": "Session Max Seconds",
          "type": "integer"
        },
        "interactive_flow_max_seconds": {
          "default": 600,
          "maximum": 1800,
          "minimum": 60,
          "title": "Interactive Flow Max Seconds",
          "type": "integer"
        },
        "interactive_flow_max_sessions": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Interactive Flow Max Sessions",
          "type": "integer"
        },
        "body_limit_bytes": {
          "default": 65536,
          "maximum": 1048576,
          "minimum": 1024,
          "title": "Body Limit Bytes",
          "type": "integer"
        },
        "read_timeout_seconds": {
          "default": 10.0,
          "maximum": 60.0,
          "minimum": 1.0,
          "title": "Read Timeout Seconds",
          "type": "number"
        },
        "rate_limit_per_minute": {
          "default": 60,
          "maximum": 100000,
          "minimum": 1,
          "title": "Rate Limit Per Minute",
          "type": "integer"
        },
        "trusted_proxies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Trusted Proxies",
          "type": "array"
        },
        "handoff_clock_skew_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 0,
          "title": "Handoff Clock Skew Seconds",
          "type": "integer"
        },
        "handoff_verification_key": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handoff Verification Key"
        },
        "handoff_signing_key": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handoff Signing Key"
        }
      },
      "title": "WebCompanionSection",
      "type": "object"
    },
