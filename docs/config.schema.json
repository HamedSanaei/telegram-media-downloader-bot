{
  "$defs": {
    "AppSection": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "default": "production",
          "enum": [
            "development",
            "test",
            "production"
          ],
          "title": "Environment",
          "type": "string"
        },
        "log_level": {
          "default": "INFO",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "title": "Log Level",
          "type": "string"
        },
        "log_format": {
          "default": "json",
          "enum": [
            "json",
            "console"
          ],
          "title": "Log Format",
          "type": "string"
        },
        "language": {
          "default": "fa",
          "title": "Language",
          "type": "string"
        },
        "timezone": {
          "default": "Asia/Tehran",
          "title": "Timezone",
          "type": "string"
        }
      },
      "title": "AppSection",
      "type": "object"
    },
    "DownloadMode": {
      "enum": [
        "best",
        "best_original",
        "video_2160",
        "video_1440",
        "video_1080",
        "video_720",
        "video_480",
        "audio_best",
        "audio_mp3"
      ],
      "title": "DownloadMode",
      "type": "string"
    },
    "FormatSection": {
      "additionalProperties": false,
      "properties": {
        "best": {
          "title": "Best",
          "type": "string"
        },
        "best_original": {
          "default": "bv*+ba/b",
          "title": "Best Original",
          "type": "string"
        },
        "video_2160": {
          "default": "bv*[height<=2160]+ba/b[height<=2160]",
          "title": "Video 2160",
          "type": "string"
        },
        "video_1440": {
          "default": "bv*[height<=1440]+ba/b[height<=1440]",
          "title": "Video 1440",
          "type": "string"
        },
        "video_1080": {
          "title": "Video 1080",
          "type": "string"
        },
        "video_720": {
          "title": "Video 720",
          "type": "string"
        },
        "video_480": {
          "title": "Video 480",
          "type": "string"
        },
        "audio_best": {
          "title": "Audio Best",
          "type": "string"
        },
        "audio_mp3": {
          "title": "Audio Mp3",
          "type": "string"
        }
      },
      "required": [
        "best",
        "video_1080",
        "video_720",
        "video_480",
        "audio_best",
        "audio_mp3"
      ],
      "title": "FormatSection",
      "type": "object"
    },
    "InstagramSection": {
      "additionalProperties": false,
      "properties": {
        "auto_download": {
          "default": true,
          "title": "Auto Download",
          "type": "boolean"
        },
        "force_mp4": {
          "default": true,
          "title": "Force Mp4",
          "type": "boolean"
        },
        "ignore_images": {
          "default": true,
          "title": "Ignore Images",
          "type": "boolean"
        },
        "max_videos": {
          "default": 50,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Videos",
          "type": "integer"
        },
        "max_total_size_mb": {
          "default": 4096,
          "maximum": 8192,
          "minimum": 1,
          "title": "Max Total Size Mb",
          "type": "integer"
        }
      },
      "title": "InstagramSection",
      "type": "object"
    },
    "LocalBotApiMigrationSection": {
      "additionalProperties": false,
      "properties": {
        "auto_logout_from_cloud": {
          "const": false,
          "default": false,
          "title": "Auto Logout From Cloud",
          "type": "boolean"
        },
        "state_file": {
          "format": "path",
          "title": "State File",
          "type": "string"
        }
      },
      "title": "LocalBotApiMigrationSection",
      "type": "object"
    },
    "LocalBotApiSection": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "mode": {
          "default": "external",
          "enum": [
            "managed",
            "external"
          ],
          "title": "Mode",
          "type": "string"
        },
        "executable": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable"
        },
        "api_id": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Id"
        },
        "api_hash": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Hash"
        },
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8081,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "local_mode": {
          "default": true,
          "title": "Local Mode",
          "type": "boolean"
        },
        "working_directory": {
          "format": "path",
          "title": "Working Directory",
          "type": "string"
        },
        "temp_directory": {
          "format": "path",
          "title": "Temp Directory",
          "type": "string"
        },
        "log_file": {
          "format": "path",
          "title": "Log File",
          "type": "string"
        },
        "verbosity": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Verbosity",
          "type": "integer"
        },
        "auto_start": {
          "default": true,
          "title": "Auto Start",
          "type": "boolean"
        },
        "lifecycle_owner": {
          "default": "application",
          "enum": [
            "application",
            "service"
          ],
          "title": "Lifecycle Owner",
          "type": "string"
        },
        "startup_timeout_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "title": "Startup Timeout Seconds",
          "type": "integer"
        },
        "shutdown_timeout_seconds": {
          "default": 20,
          "maximum": 300,
          "minimum": 1,
          "title": "Shutdown Timeout Seconds",
          "type": "integer"
        },
        "migration": {
          "$ref": "#/$defs/LocalBotApiMigrationSection"
        }
      },
      "title": "LocalBotApiSection",
      "type": "object"
    },
    "MediaSection": {
      "additionalProperties": false,
      "properties": {
        "enabled_sources": {
          "items": {
            "type": "string"
          },
          "title": "Enabled Sources",
          "type": "array",
          "uniqueItems": true
        },
        "enabled_modes": {
          "default": [
            "best",
            "best_original",
            "video_2160",
            "video_1440",
            "video_1080",
            "video_720",
            "video_480",
            "audio_best",
            "audio_mp3"
          ],
          "items": {
            "$ref": "#/$defs/DownloadMode"
          },
          "title": "Enabled Modes",
          "type": "array"
        },
        "default_mode": {
          "$ref": "#/$defs/DownloadMode",
          "default": "best"
        },
        "allow_playlists": {
          "default": false,
          "title": "Allow Playlists",
          "type": "boolean"
        },
        "playlist_max_items": {
          "default": 20,
          "maximum": 500,
          "minimum": 1,
          "title": "Playlist Max Items",
          "type": "integer"
        },
        "max_file_size_mb": {
          "default": 49,
          "minimum": 1,
          "title": "Max File Size Mb",
          "type": "integer"
        },
        "max_source_size_mb": {
          "default": 1024,
          "maximum": 8192,
          "minimum": 1,
          "title": "Max Source Size Mb",
          "type": "integer"
        },
        "max_duration_seconds": {
          "default": 14400,
          "minimum": 1,
          "title": "Max Duration Seconds",
          "type": "integer"
        },
        "mp4_native_fallback": {
          "$ref": "#/$defs/Mp4NativeFallback",
          "default": "lower_resolution"
        },
        "formats": {
          "$ref": "#/$defs/FormatSection"
        },
        "instagram": {
          "$ref": "#/$defs/InstagramSection"
        },
        "transcode": {
          "$ref": "#/$defs/TranscodeSection"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceCleanupSection"
        }
      },
      "required": [
        "enabled_sources",
        "formats"
      ],
      "title": "MediaSection",
      "type": "object"
    },
    "Mp4NativeFallback": {
      "enum": [
        "lower_resolution",
        "fail"
      ],
      "title": "Mp4NativeFallback",
      "type": "string"
    },
    "MultipartSection": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "seven_zip_executable": {
          "format": "path",
          "title": "Seven Zip Executable",
          "type": "string"
        },
        "part_size_mb": {
          "default": 1850,
          "maximum": 1900,
          "minimum": 1,
          "title": "Part Size Mb",
          "type": "integer"
        },
        "max_total_size_mb": {
          "default": 4096,
          "maximum": 8192,
          "minimum": 1,
          "title": "Max Total Size Mb",
          "type": "integer"
        },
        "compression_level": {
          "const": 0,
          "default": 0,
          "title": "Compression Level",
          "type": "integer"
        }
      },
      "title": "MultipartSection",
      "type": "object"
    },
    "ObservabilitySection": {
      "additionalProperties": false,
      "properties": {
        "health_host": {
          "default": "0.0.0.0",
          "title": "Health Host",
          "type": "string"
        },
        "health_port": {
          "default": 8080,
          "maximum": 65535,
          "minimum": 1,
          "title": "Health Port",
          "type": "integer"
        },
        "telegram_readiness_check": {
          "default": true,
          "title": "Telegram Readiness Check",
          "type": "boolean"
        },
        "metrics_enabled": {
          "default": true,
          "title": "Metrics Enabled",
          "type": "boolean"
        }
      },
      "title": "ObservabilitySection",
      "type": "object"
    },
    "OperationsSection": {
      "additionalProperties": false,
      "properties": {
        "update": {
          "$ref": "#/$defs/UpdateOperationsSection"
        }
      },
      "title": "OperationsSection",
      "type": "object"
    },
    "PersistenceSection": {
      "additionalProperties": false,
      "properties": {
        "database_filename": {
          "default": "jobs.sqlite3",
          "title": "Database Filename",
          "type": "string"
        },
        "selection_ttl_seconds": {
          "default": 600,
          "maximum": 86400,
          "minimum": 60,
          "title": "Selection Ttl Seconds",
          "type": "integer"
        },
        "cleanup_interval_seconds": {
          "default": 60,
          "maximum": 86400,
          "minimum": 30,
          "title": "Cleanup Interval Seconds",
          "type": "integer"
        }
      },
      "title": "PersistenceSection",
      "type": "object"
    },
    "QueueSection": {
      "additionalProperties": false,
      "properties": {
        "max_jobs": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Jobs",
          "type": "integer"
        },
        "job_timeout_seconds": {
          "default": 1800,
          "minimum": 30,
          "title": "Job Timeout Seconds",
          "type": "integer"
        },
        "max_tries": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Tries",
          "type": "integer"
        },
        "keep_result_seconds": {
          "default": 3600,
          "minimum": 0,
          "title": "Keep Result Seconds",
          "type": "integer"
        },
        "retry_delay_seconds": {
          "default": 15,
          "maximum": 3600,
          "minimum": 1,
          "title": "Retry Delay Seconds",
          "type": "integer"
        }
      },
      "title": "QueueSection",
      "type": "object"
    },
    "RedisSection": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "default": "redis://redis:6379/0",
          "title": "Url",
          "type": "string"
        },
        "queue_name": {
          "default": "media-downloads",
          "title": "Queue Name",
          "type": "string"
        }
      },
      "title": "RedisSection",
      "type": "object"
    },
    "RequiredChannelSection": {
      "additionalProperties": false,
      "properties": {
        "chat_id": {
          "title": "Chat Id",
          "type": "integer"
        },
        "title": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "join_url": {
          "title": "Join Url",
          "type": "string"
        }
      },
      "required": [
        "chat_id",
        "title",
        "join_url"
      ],
      "title": "RequiredChannelSection",
      "type": "object"
    },
    "RequiredChannelsSection": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "positive_cache_ttl_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 1,
          "title": "Positive Cache Ttl Seconds",
          "type": "integer"
        },
        "negative_cache_ttl_seconds": {
          "default": 30,
          "maximum": 3600,
          "minimum": 1,
          "title": "Negative Cache Ttl Seconds",
          "type": "integer"
        },
        "channels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RequiredChannelSection"
          },
          "title": "Channels",
          "type": "array"
        }
      },
      "title": "RequiredChannelsSection",
      "type": "object"
    },
    "SecuritySection": {
      "additionalProperties": false,
      "properties": {
        "allowed_user_ids": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Allowed User Ids",
          "type": "array",
          "uniqueItems": true
        },
        "blocked_user_ids": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Blocked User Ids",
          "type": "array",
          "uniqueItems": true
        },
        "requests_per_minute": {
          "default": 5,
          "maximum": 1000,
          "minimum": 1,
          "title": "Requests Per Minute",
          "type": "integer"
        },
        "reject_private_network_urls": {
          "default": true,
          "title": "Reject Private Network Urls",
          "type": "boolean"
        }
      },
      "title": "SecuritySection",
      "type": "object"
    },
    "StorageSection": {
      "additionalProperties": false,
      "properties": {
        "root_directory": {
          "default": "/data",
          "format": "path",
          "title": "Root Directory",
          "type": "string"
        },
        "downloads_directory": {
          "default": "downloads",
          "format": "path",
          "title": "Downloads Directory",
          "type": "string"
        },
        "temp_directory": {
          "default": "temp",
          "format": "path",
          "title": "Temp Directory",
          "type": "string"
        },
        "state_directory": {
          "default": "state",
          "format": "path",
          "title": "State Directory",
          "type": "string"
        },
        "delete_after_upload": {
          "default": true,
          "title": "Delete After Upload",
          "type": "boolean"
        },
        "orphan_grace_seconds": {
          "default": 300,
          "minimum": 30,
          "title": "Orphan Grace Seconds",
          "type": "integer"
        },
        "job_retention_days": {
          "default": 30,
          "maximum": 3650,
          "minimum": 1,
          "title": "Job Retention Days",
          "type": "integer"
        }
      },
      "title": "StorageSection",
      "type": "object"
    },
    "TelegramSection": {
      "additionalProperties": false,
      "properties": {
        "bot_token": {
          "format": "password",
          "title": "Bot Token",
          "type": "string",
          "writeOnly": true
        },
        "admin_ids": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Admin Ids",
          "type": "array"
        },
        "support_username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Username"
        },
        "polling_timeout_seconds": {
          "default": 30,
          "maximum": 60,
          "minimum": 5,
          "title": "Polling Timeout Seconds",
          "type": "integer"
        },
        "upload_as_document": {
          "default": true,
          "title": "Upload As Document",
          "type": "boolean"
        },
        "max_upload_size_mb": {
          "default": 49,
          "maximum": 1900,
          "minimum": 1,
          "title": "Max Upload Size Mb",
          "type": "integer"
        },
        "upload_timeout_seconds": {
          "default": 14400,
          "maximum": 86400,
          "minimum": 60,
          "title": "Upload Timeout Seconds",
          "type": "integer"
        },
        "upload_chunk_size_kb": {
          "default": 1024,
          "maximum": 4096,
          "minimum": 64,
          "title": "Upload Chunk Size Kb",
          "type": "integer"
        },
        "upload_heartbeat_interval_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 5,
          "title": "Upload Heartbeat Interval Seconds",
          "type": "integer"
        },
        "caption_template": {
          "default": "{title}\nمنبع: {source}\nدریافت‌شده با @{bot_username}",
          "title": "Caption Template",
          "type": "string"
        },
        "filename_max_length": {
          "default": 96,
          "maximum": 180,
          "minimum": 16,
          "title": "Filename Max Length",
          "type": "integer"
        },
        "local_api_base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Api Base Url"
        },
        "local_api_is_local": {
          "default": false,
          "title": "Local Api Is Local",
          "type": "boolean"
        },
        "local_bot_api": {
          "$ref": "#/$defs/LocalBotApiSection"
        },
        "required_channels": {
          "$ref": "#/$defs/RequiredChannelsSection"
        },
        "progress_min_interval_seconds": {
          "default": 3.0,
          "maximum": 60.0,
          "minimum": 1.0,
          "title": "Progress Min Interval Seconds",
          "type": "number"
        },
        "progress_min_percent_delta": {
          "default": 5.0,
          "maximum": 100.0,
          "minimum": 1.0,
          "title": "Progress Min Percent Delta",
          "type": "number"
        }
      },
      "required": [
        "bot_token"
      ],
      "title": "TelegramSection",
      "type": "object"
    },
    "TranscodeSection": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "explicit_mp4_enabled": {
          "default": false,
          "title": "Explicit Mp4 Enabled",
          "type": "boolean"
        },
        "threads": {
          "default": 2,
          "maximum": 16,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        },
        "max_concurrent": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Concurrent",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 1500,
          "maximum": 86400,
          "minimum": 30,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "progress_interval_seconds": {
          "default": 10,
          "maximum": 300,
          "minimum": 1,
          "title": "Progress Interval Seconds",
          "type": "integer"
        }
      },
      "title": "TranscodeSection",
      "type": "object"
    },
    "UpdateOperationsSection": {
      "additionalProperties": false,
      "properties": {
        "prune_old_project_images_after_success": {
          "default": true,
          "title": "Prune Old Project Images After Success",
          "type": "boolean"
        }
      },
      "title": "UpdateOperationsSection",
      "type": "object"
    },
    "WorkspaceCleanupSection": {
      "additionalProperties": false,
      "properties": {
        "cleanup_on_success": {
          "default": true,
          "title": "Cleanup On Success",
          "type": "boolean"
        },
        "cleanup_on_failure": {
          "default": true,
          "title": "Cleanup On Failure",
          "type": "boolean"
        },
        "cleanup_on_cancel": {
          "default": true,
          "title": "Cleanup On Cancel",
          "type": "boolean"
        },
        "cleanup_on_timeout": {
          "default": true,
          "title": "Cleanup On Timeout",
          "type": "boolean"
        }
      },
      "title": "WorkspaceCleanupSection",
      "type": "object"
    },
    "YtDlpSection": {
      "additionalProperties": false,
      "properties": {
        "cookies_file": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cookies File"
        },
        "proxy_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy Enabled"
        },
        "proxy": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy"
        },
        "socket_timeout_seconds": {
          "default": 30,
          "minimum": 1,
          "title": "Socket Timeout Seconds",
          "type": "integer"
        },
        "retries": {
          "default": 5,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "fragment_retries": {
          "default": 10,
          "minimum": 0,
          "title": "Fragment Retries",
          "type": "integer"
        },
        "concurrent_fragments": {
          "default": 4,
          "maximum": 32,
          "minimum": 1,
          "title": "Concurrent Fragments",
          "type": "integer"
        },
        "extractor_retries": {
          "default": 3,
          "minimum": 0,
          "title": "Extractor Retries",
          "type": "integer"
        },
        "restrict_filenames": {
          "default": true,
          "title": "Restrict Filenames",
          "type": "boolean"
        },
        "write_thumbnail": {
          "default": false,
          "title": "Write Thumbnail",
